    <!-- TABS CONTAINER -->
    <div class="bg-white rounded-2xl shadow-md overflow-hidden max-w-6xl mx-auto">
        <!-- Tab bar -->
        <div class="flex flex-wrap gap-1 px-5 pt-4 pb-0 bg-parchment-dark border-b border-parchment-dark">
