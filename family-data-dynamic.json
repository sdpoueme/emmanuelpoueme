        <!-- Tab panels -->
        <div class="p-7">

            <!-- Overview Tab -->
            <div id="overview" class="tab-content active">
                <h2 class="font-serif text-2xl text-forest mb-5">Vue d'ensemble de la famille</h2>
                <div id="overviewContent"></div>
            </div>

            <!-- Royal Lineages Tab -->
            <div id="royal" class="tab-content">
                <h2 class="font-serif text-2xl text-forest mb-5">Lignees Royales</h2>
                <!-- Statut Royal -->
                <div class="bg-ochre-pale border border-ochre rounded-xl p-7 mb-7 text-center">
                    <h3 class="font-serif text-xl text-forest mb-3">Statut Royal</h3>
                    <p class="text-ink-mid leading-relaxed max-w-2xl mx-auto">
                        En tant que descendants des chefferies <strong class="text-ink">Baleng</strong>,
                        <strong class="text-ink">Balengou</strong>, <strong class="text-ink">Batchingou</strong>
                        et <strong class="text-ink">Bamena</strong>, les descendants de Magni Kouabou et
                        de Tchié Ngantchié sont des <strong class="text-ochre">princes et altesses royales</strong>
                        des Grassfields Bamiléké.
                    </p>
                </div>

                <!-- L'Exil de 1770 — Rupture Dynastique -->
                <div class="bg-ink rounded-2xl p-7 mb-7 text-cream">
                    <div class="flex items-center gap-3 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 flex-shrink-0" style="color:#C07D2A" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
                        </svg>
                        <h3 class="font-serif text-xl" style="color:#E8A84B">L'Exil de 1770 — La Rupture Dynastique</h3>
                    </div>
                    <p class="text-sm leading-relaxed mb-4"
