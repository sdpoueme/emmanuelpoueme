    <script>
    tailwind.config = {
      theme: { extend: {
        colors: {
          ochre: { DEFAULT:'#C07D2A', light:'#E8A84B', pale:'#FDF3E3', dark:'#8E5C1A' },
          terra: { DEFAULT:'#A0522D', light:'#C4704A' },
          forest: { DEFAULT:'#2E5C3A', mid:'#4A7C53', light:'#7FB08A' },
          parchment: { DEFAULT:'#F5EDD8', dark:'#E8D9BC' },
          ink: { DEFAULT:'#1E1A14', mid:'#4A4035', light:'#7A7060' },
          cream: '#FFFBF4',
        },
