    <script src="https://d3js.org/d3.v7.min.js"></script>
    <style>
        /* Person box glass style */
        .person-box {
            background: rgba(255,255,255,0.58);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 24px;
            border: 1px solid rgba(255,255,255,0.75);
            border-left: 4px solid var(--gen-accent, #C07D2A);
            box-shadow: 0 4px 18px rgba(160,82,45,0.10), 0 1px 4px rgba(30,26,20,0.06), inset 0 1px 0 rgba(255,255,255,0.8);
            padding: 14px 18px;
            min-width: 150px;
            max-width: 205px;
            cursor: pointer;
            text-align: center;
            position: relative;
            transition: transform 0.22s, box-shadow 0.22s;
        }
        .person-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 28px rgba(160,82,45,0.18), 0 2px 8px rgba(30,26,20,0.10), inset 0 1px 0 rgba(255,255,255,0.8);
        }
        .person-box.highlighted {
            border-color: #ff6b6b !important;
            box-shadow: 0 0 15px rgba(255, 107, 107, 0.5) !important;
        }
        .person-box.hero-dark {
            background: #1E1A14 !important;
            border: 1px solid #3A3028 !important;
            border-left: 4px solid #C07D2A !important;
            box-shadow: 0 6px 24px rgba(30,26,20,0.4) !important;
        }
        .person-box.hero-dark .person-name { color: #F5EDD8; }
        .person-box.hero-dark .person-dates { color: #7A7060; }
        .person-box.hero-dark .person-role { color: #E8A84B; }

        /* Merged lineage */
        .person-box.merged-lineage {
            border: 3px double #C07D2A !important;
            box-shadow: 0 0 10px rgba(192, 125, 42, 0.3);
        }
        .person-box.merged-lineage::before {
            content: "";
            position: absolute;
            top: -10px;
            right: -10px;
            background: #C07D2A;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            z-index: 10;
        }

        .person-name { font-weight: 700; font-size: 0.95em; margin-bottom: 3px; color: #1E1A14; }
        .person-dates { font-size: 0.82em; color: #4A4035; }
        .person-role { font-size: 0.78em; margin-top: 4px; font-weight: 500; color: #C07D2A; }

        /* Generation row */
        .generation-row { display: flex; justify-content: center; align-items: flex-start; margin-bottom: 48px; position: relative; }
        .generation-row.hidden { display: none; }

        .generation-label {
            writing-mode: vertical-rl;
            text-orientation: mixed;
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 0.7em;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            padding: 12px 8px;
            border-radius: 8px;
            margin-right: 16px;
            border-left: 3px solid var(--gen-color, #2E5C3A);
            color: var(--gen-color, #2E5C3A);
            background: var(--gen-bg, rgba(46,92,58,0.08));
        }

        .members-container {
            display: flex;
            gap: 18px;
            flex-wrap: wrap;
            justify-content: center;
            flex: 1;
            position: relative;
            z-index: 2;
        }

        /* Marriage lines SVG overlay */
        .marriage-lines {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* Tab content */
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* Tab buttons */
        .tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 16px;
            font-size: 0.88em;
            font-weight: 500;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: #4A4035;
            cursor: pointer;
            transition: all 0.2s;
            border-bottom: 3px solid transparent;
        }
        .tab-btn:hover { color: #2E5C3A; background: rgba(46,92,58,0.06); }
        .tab-btn.active {
            color: #2E5C3A;
            background: white;
            border-bottom-color: #C07D2A;
            font-weight: 600;
        }

        /* Slide-in panel */
        .slide-panel {
            position: fixed;
            top: 0; right: 0;
            height: 100%; width: 420px;
            max-width: 92vw;
            background: #FFFBF4;
            box-shadow: -4px 0 24px rgba(30,26,20,0.15);
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
            z-index: 1100;
            overflow-y: auto;
            border-left: 4px solid #C07D2A;
        }
        .slide-panel.open { transform: translateX(0); }
        .slide-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(30,26,20,0.4);
            backdrop-filter: blur(2px);
            z-index: 1050;
            display: none;
        }
        .slide-overlay.open { display: block; }

        /* Filter pills */
        .gen-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            border-radius: 20px;
            border: 2px solid var(--pill-color, #2E5C3A);
            background: white;
            color: var(--pill-color, #2E5C3A);
            font-size: 0.82em;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }
        .gen-pill:hover { transform: translateY(-2px); box-shadow: 0 3px 8px rgba(0,0,0,0.12); }
        .gen-pill.active {
            background: var(--pill-color, #2E5C3A);
            color: white;
        }
        .gen-pill .dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--pill-color, #2E5C3A);
        }
        .gen-pill.active .dot { background: white; }

        /* Timeline spine */
        .timeline-spine {
            position: absolute;
            left: 16px; top: 0; bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, #A0522D 0%, #C07D2A 50%, #2E5C3A 100%);
            border-radius: 2px;
        }
        .timeline-dot {
            width: 12px; height: 12px;
            border-radius: 50%;
            background: #C07D2A;
            border: 2px solid #FFFBF4;
            position: absolute;
            left: 11px;
            top: 4px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .generation-label { writing-mode: horizontal-tb; margin-right: 0; margin-bottom: 10px; }
            .slide-panel { width: 100%; }
        }

        .d3-menu-btn {
            display: block; width: 100%; text-align: left;
            padding: 7px 12px; border: none; background: none;
            font-size: 0.85em; color: #1E1A14; cursor: pointer;
            border-radius: 6px; font-family: "DM Sans", sans-serif;
            transition: background 0.15s;
        }
        .d3-menu-btn:hover { background: #FDF3E3; color: #2E5C3A; }
        .d3-viz-btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 13px; border: 1.5px solid #4A7C53; border-radius: 20px;
            background: white; color: #4A7C53; font-size: 0.8em; font-weight: 600;
            cursor: pointer; transition: all 0.2s; font-family: "DM Sans", ui-sans-serif, sans-serif;
        }
        .d3-viz-btn:hover { transform: translateY(-1px); box-shadow: 0 2px 6px rgba(46,92,58,0.2); }
        .d3-viz-btn.active { background: #2E5C3A; color: white; border-color: #2E5C3A; }
    </style>
</head>
<body class="bg-parchment min-h-screen py-7 px-5 font-sans">

    <!-- HEADER -->
    <div class="bg-white rounded-2xl shadow-md overflow-hidden mb-8 max-w-6xl mx-auto">
        <div style="height:5px;background:linear-gradient(90deg,#A0522D 0%,#C07D2A 50%,#2E5C3A 100%)"></div>
        <div class="text-center px-8 py-10">
            <h1 class="font-serif text-4xl font-bold text-forest flex items-center justify-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-forest" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-6m0 0c-2.5 0-4.5-1.5-5.5-3.5C5.5 9.5 7 6.5 9 5c1-.8 2-1.5 3-2 1 .5 2 1.2 3 2 2 1.5 3.5 4.5 2.5 6.5-1 2-3 3.5-5.5 3.5z"/>
